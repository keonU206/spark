# 이 파일을 `.env`로 복사해서 쓰세요. `.env`는 커밋되지 않습니다.

# Expo CLI가 시작 시 원격으로 의존성 버전을 조회하는데, 그 응답 처리에 버그가 있어
# "TypeError: Body is unusable" 로 기동이 실패한다. 이 검사를 건너뛴다.
EXPO_NO_DEPENDENCY_VALIDATION=1

# 백엔드 주소.
# - 웹(npm run web)에서 보면: http://localhost:4000
# - 폰(dev client)에서 보면: PC의 내부 IP (ipconfig의 IPv4) — 예: http://192.168.0.10:4000
# - 배포 빌드: 클라우드 서버의 https 주소
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# false면 실서버로 붙고, 지우거나 다른 값이면 mock으로 동작한다.
EXPO_PUBLIC_USE_MOCK=false
